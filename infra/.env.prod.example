# ==============================================================================
# Sora — Exemplo de .env de PRODUÇÃO / HOMOLOGAÇÃO
# ==============================================================================
# NÃO preencha e comite este arquivo. O bootstrap-server.sh gera o .env real
# no servidor (/opt/sora/.env) com senhas alfanuméricas fortes e chmod 600.
#
# Este arquivo serve como referência das variáveis para a Stack do Portainer
# e para validação do docker-compose.prod.yml no CI.

# ------------------------------------------------------------------
# Domínio e TLS
# ------------------------------------------------------------------
DOMAIN_BASE=sora.app
ACME_EMAIL=admin@example.com
# Token Cloudflare (DNS:Edit) — necessário apenas para TLS wildcard
CF_DNS_API_TOKEN=

# ------------------------------------------------------------------
# Imagens (GHCR) — geradas/enviadas pelo GitHub Actions
# ------------------------------------------------------------------
API_IMAGE=ghcr.io/change-me/sora-api
WEB_IMAGE=ghcr.io/change-me/sora-web
IMAGE_TAG=latest

# ------------------------------------------------------------------
# PostgreSQL 16 (Separado entre Owner/Migrations e Role RLS da Aplicação)
# ------------------------------------------------------------------
POSTGRES_DB=sora
POSTGRES_USER=sora
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_APP_USER=sora_app
POSTGRES_APP_PASSWORD=CHANGE_ME
# Usada pelo FastAPI em runtime (role sora_app com NOSUPERUSER + NOBYPASSRLS)
DATABASE_URL=postgresql+asyncpg://sora_app:CHANGE_ME@postgres:5432/sora
# Usada exclusivamente pelo Alembic para rodar migrations DDL
MIGRATION_DATABASE_URL=postgresql+asyncpg://sora:CHANGE_ME@postgres:5432/sora

# ------------------------------------------------------------------
# Redis 7 (gerado pelo bootstrap)
# ------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# ------------------------------------------------------------------
# Aplicação, Timezone, JWT e Criptografia de Coluna (gerado pelo bootstrap)
# ------------------------------------------------------------------
APP_NAME=Sora Studio
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO
TZ=UTC
DEFAULT_TENANT_TIMEZONE=America/Sao_Paulo
APP_SECRET_KEY=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------
# Integrações (preencher manualmente quando contratadas)
# ------------------------------------------------------------------
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=CHANGE_ME

AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
WHISPER_PROVIDER=groq
WHISPER_API_KEY=

PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=CHANGE_ME

STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PRESIGNED_URL_TTL_SECONDS=60

# ------------------------------------------------------------------
# E-mail Transacional e Observabilidade
# ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@sora.app
SENTRY_DSN=
BACKUP_WEBHOOK_ALERT_URL=
