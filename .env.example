# ==============================================================================
# Sora Studio — Exemplo de variáveis de ambiente (DESENVOLVIMENTO LOCAL)
# Copie para .env e preencha. NUNCA comite o .env real.
# ==============================================================================

# ------------------------------------------------------------------
# Aplicação e Timezone
# ------------------------------------------------------------------
APP_NAME="Sora Studio"
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=DEBUG
TZ=UTC
DEFAULT_TENANT_TIMEZONE=America/Sao_Paulo
APP_SECRET_KEY=change-me-in-production
# Chave de criptografia de coluna (Fernet 32-byte urlsafe base64 ou 64 chars alfanuméricos)
ENCRYPTION_KEY=change-me-encryption-key-64-chars-minimum-for-column-aes-gcm-dev
# Token compartilhado para endpoints internos (roteador determinístico do WhatsApp)
INTERNAL_API_TOKEN=dev-internal-token
# Pagamento Pix (mock nas primeiras fases; provider real na Fase 5)
PAYMENT_PROVIDER=mock
PAYMENT_PIX_KEY=pix@sora.local
PAYMENT_MERCHANT_NAME=SORA STUDIO
PAYMENT_MERCHANT_CITY=SAO PAULO
PAYMENT_SUBSCRIPTION_TTL_MINUTES=30
# WhatsApp (mock nas primeiras fases; Meta Cloud API na integração final)
WHATSAPP_PROVIDER=mock
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
APP_BASE_URL=http://app.sora.localhost:8000
API_BASE_URL=http://api.sora.localhost:8000
PUBLIC_BOOKING_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
INTERNAL_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------
# PostgreSQL 16 (Separado entre Owner/Migrations e Role RLS da Aplicação)
# ------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
# Porta do HOST para o Docker Compose de dev (internamente o container usa 5432).
# 5433 evita conflito com outras stacks locais; ajuste se necessário.
POSTGRES_PORT=5433
POSTGRES_DB=sora
# Owner / DDL (usado apenas pelo Alembic nas migrations)
POSTGRES_USER=sora
POSTGRES_PASSWORD=sora_dev_only
MIGRATION_DATABASE_URL=postgresql+asyncpg://sora:sora_dev_only@127.0.0.1:5433/sora
# Role da Aplicação com NOSUPERUSER + NOBYPASSRLS (usado pelo FastAPI em runtime)
POSTGRES_APP_USER=sora_app
POSTGRES_APP_PASSWORD=sora_app_dev_only
DATABASE_URL=postgresql+asyncpg://sora_app:sora_app_dev_only@127.0.0.1:5433/sora

# ------------------------------------------------------------------
# Redis 7
# ------------------------------------------------------------------
REDIS_HOST=127.0.0.1
# Porta do HOST para o Docker Compose de dev (internamente o container usa 6379).
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=sora_dev_only
REDIS_URL=redis://:sora_dev_only@127.0.0.1:6380/0

# ------------------------------------------------------------------
# Autenticação (JWT)
# ------------------------------------------------------------------
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_SECRET_KEY=change-me-in-production-at-least-32-bytes
JWT_ISSUER=sora-api
JWT_AUDIENCE=sora-clients
# Senha master do console do provedor (/sistema). Deixe vazia para desativar.
SYSTEM_ADMIN_PASSWORD=

# ------------------------------------------------------------------
# Storage privado (prontuários / fotos) — local em dev, S3/R2 em prod
# ------------------------------------------------------------------
# `local` grava em STORAGE_LOCAL_PATH e assina URLs na própria API (sem MinIO).
# Para MinIO/S3/R2 use `s3` e preencha as credenciais abaixo.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=var/storage-private
STORAGE_MAX_ATTACHMENT_BYTES=10485760
STORAGE_BUCKET=sora-private
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_ACCESS_KEY_ID=sora_minio
STORAGE_SECRET_ACCESS_KEY=sora_minio_dev_only
STORAGE_PRESIGNED_URL_TTL_SECONDS=60

# ------------------------------------------------------------------
# WhatsApp (Meta Cloud API / provedor)
# ------------------------------------------------------------------
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=dev_verify_token

# ------------------------------------------------------------------
# SORA IA (LLM / transcrição)
# ------------------------------------------------------------------
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
WHISPER_PROVIDER=groq
WHISPER_API_KEY=

# ------------------------------------------------------------------
# Pagamentos (PaymentGatewayPort) — mock no MVP
# ------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=dev_webhook_secret

# ------------------------------------------------------------------
# E-mail Transacional (Recuperação de senha / Convite de colaborador)
# ------------------------------------------------------------------
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@sora.localhost

# ------------------------------------------------------------------
# Observabilidade e Alertas
# ------------------------------------------------------------------
SENTRY_DSN=
BACKUP_WEBHOOK_ALERT_URL=

# ------------------------------------------------------------------
# Traefik / Domínios
# ------------------------------------------------------------------
DOMAIN_BASE=sora.localhost
ACME_EMAIL=admin@example.com
# Portas do HOST para o Traefik em dev (80/8080 internos).
TRAEFIK_HTTP_PORT=8000
TRAEFIK_DASHBOARD_PORT=8081
