{
  "expo": {
    "name": "Sora Studio",
    "slug": "sora-studio",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "sora",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.sora.studio"
    },
    "android": {
      "package": "app.sora.studio"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita acessar suas fotos para anexar ao prontuário.",
          "cameraPermission": "Permita usar a câmera para fotografar o prontuário."
        }
      ]
    ]
  }
}
