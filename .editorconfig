# ==============================================================================
# EditorConfig — mantém estilo consistente entre editores e IAs
# https://editorconfig.org
# ==============================================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{js,jsx,ts,tsx,json,yml,yaml,css,scss,md,mdx}]
indent_size = 2

[*.{go,rs}]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
